<Project Sdk="Microsoft.NET.Sdk">

  <!-- External-engine slot test project: net8.0 console, zero NuGet packages,
       drives NetTrans.Kernel directly via ProjectReference. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ExternalEngineTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ExternalEngineTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../NetTrans.Kernel/NetTrans.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TestKit/TestKit.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- 网络层独立测试工程：net8.0 控制台，零 NuGet 依赖，
       通过 ProjectReference 直接驱动 NetTrans.Kernel。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NetworkTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetworkTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../NetTrans.Kernel/NetTrans.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../TestKit/TestKit.cs" />
  </ItemGroup>

</Project>

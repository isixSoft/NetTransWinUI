<Project Sdk="Microsoft.NET.Sdk">

  <!-- 压力/边界测试工程：net8.0 控制台，零 NuGet 依赖，
       通过 RealDownloadKernel + 本地 TestServer 做 64 连接并发、排队调度、
       限速精度统计与内存峰值观察。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>StressTests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StressTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../NetTrans.Kernel/NetTrans.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../TestKit/TestKit.cs" />
  </ItemGroup>

</Project>
